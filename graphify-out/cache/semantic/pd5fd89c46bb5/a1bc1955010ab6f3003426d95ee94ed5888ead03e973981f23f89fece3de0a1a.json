{"nodes": [{"id": "openspec_specs_agentic_diff_mode_spec", "label": "Agentic Diff Mode Spec (published)", "file_type": "document", "source_file": "openspec/specs/agentic-diff-mode/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agentic_diff_mode", "label": "Agentic Diff Mode", "file_type": "concept", "source_file": "openspec/specs/agentic-diff-mode/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full PR diff embedded in prompt hits 80 KB truncation limit and provides no structural awareness; agentic mode lets Jules run git diff directly for full repo context"}, {"id": "read_only_prohibition", "label": "Read-Only Prohibition", "file_type": "concept", "source_file": "openspec/specs/agentic-diff-mode/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agentic mode gives Jules repo access; a SECURITY section at prompt top prohibits modifying, creating, or deleting files to limit blast radius"}, {"id": "sha_based_diff_instruction", "label": "SHA-Based Diff Instruction", "file_type": "concept", "source_file": "openspec/specs/agentic-diff-mode/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SHAs are used in the diff instruction string for prompt-injection defense; baseBranch SDK parameter expects a branch name, not a SHA"}, {"id": "ignored_paths_mechanism", "label": "Ignored Paths Mechanism", "file_type": "concept", "source_file": "openspec/specs/agentic-diff-mode/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Action-side filterDiff remains as defence-in-depth; agentic prompt also provides ignored_paths with instructions to merge with .gitignore"}, {"id": "large_pr_nudge", "label": "Large-PR Nudge", "file_type": "concept", "source_file": "openspec/specs/agentic-diff-mode/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When >50 files changed, a soft nudge instructs Jules to prioritize high-impact reviews; no hard truncation applies in agentic mode (80 KB limit dropped)"}], "edges": [{"source": "openspec_specs_agentic_diff_mode_spec", "target": "agentic_diff_mode", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/agentic-diff-mode/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_agentic_diff_mode_spec", "target": "read_only_prohibition", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/agentic-diff-mode/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_agentic_diff_mode_spec", "target": "sha_based_diff_instruction", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/agentic-diff-mode/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_agentic_diff_mode_spec", "target": "ignored_paths_mechanism", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/agentic-diff-mode/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_agentic_diff_mode_spec", "target": "large_pr_nudge", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/agentic-diff-mode/spec.md", "source_location": null, "weight": 1.0}, {"source": "read_only_prohibition", "target": "prompt_injection_defense", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/specs/agentic-diff-mode/spec.md", "source_location